#!/usr/bin/env python3
"""PreToolUse hook: pre-approves read-only Bash commands for channel sessions.

Without it, every read-only call in a session behind a third-party gateway is
queued for the auto-mode classifier review, which can deny harmless reads and
stall the turn. This hook answers known-safe commands instantly; everything
else passes through silently, so the normal review flow is untouched.

Allow rules grow one block at a time: when a review denies a command that is
obviously read-only, add its shape to READONLY below.

Output: JSON with an ``allow`` permission decision, or nothing (no verdict —
the normal flow decides). Exits 0 in both cases.
"""

from __future__ import annotations

import json
import re
import sys

# Whole-command shapes that only read. A command qualifies only when the
# entire line is one of these — no pipes, redirects, command substitution,
# or composition, because those would execute things this list never saw.
READONLY: tuple[re.Pattern[str], ...] = (
    re.compile(r"grep(?:\s+(?:-{1,2}[\w-]+|\"[^\"]*\"|'[^']*'|\S+))+"),
)

# Composition would smuggle in non-read-only parts.
_METACHARS = re.compile(r"[|;&><`$()]")


def _readonly(command: str) -> bool:
    parts = command.strip().split()
    if not parts or parts[0] != "grep":
        return False
    if _METACHARS.search(command):
        return False
    return READONLY[0].fullmatch(command.strip()) is not None


def main() -> None:
    try:
        payload = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return
    if payload.get("tool_name") != "Bash":
        return
    command = payload.get("tool_input", {}).get("command", "")
    if not isinstance(command, str) or not _readonly(command):
        return
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "allow",
                "permissionDecisionReason": "read-only grep (channel read-only-allow hook)",
            }
        },
        sys.stdout,
    )


if __name__ == "__main__":
    main()
